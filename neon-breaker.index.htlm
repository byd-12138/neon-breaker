<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<meta name="theme-color" content="#05030e">
<meta name="description" content="霓虹破碎者 NEON BREAKER：一款单文件霓虹风打砖块街机小游戏，支持连击、道具、音效与移动端触控。">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='14' fill='%2305030e'/%3E%3Crect x='18' y='18' width='28' height='28' rx='7' transform='rotate(45 32 32)' fill='none' stroke='%233ceaff' stroke-width='3'/%3E%3C/svg%3E">
<title>NEON BREAKER · 霓虹破碎者</title>
<style>
  :root{
    color-scheme: dark;
    --bg:#05030e;
    --cyan:#3ceaff;
    --pink:#ff4fd8;
    --violet:#9b6bff;
    --amber:#ffd166;
    --mint:#6dffb8;
    --ink:#05030e;
    --panel-line:rgba(120,225,255,.16);
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    background:var(--bg);
    color:#eaf6ff;
    font-family:"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
    overflow:hidden;
    -webkit-tap-highlight-color:transparent;
    user-select:none;
    -webkit-user-select:none;
  }
  button{font-family:inherit}
  #app{position:fixed;inset:0;overflow:hidden}
  #app::after{
    content:"";
    position:absolute;inset:0;z-index:4;pointer-events:none;
    background:
      radial-gradient(ellipse at 50% 48%, transparent 52%, rgba(0,0,0,.52) 100%),
      repeating-linear-gradient(0deg, rgba(180,240,255,.022) 0 1px, transparent 1px 3px);
  }
  #game{
    position:absolute;inset:0;display:block;width:100%;height:100%;
    touch-action:none;z-index:1;
  }
  /* ---------- HUD ---------- */
  .hud{
    position:absolute;top:0;left:0;right:0;z-index:6;
    display:flex;align-items:center;gap:18px;
    padding:max(13px,env(safe-area-inset-top)) clamp(15px,3vw,32px) 14px;
    background:linear-gradient(180deg, rgba(5,3,14,.92) 0%, rgba(5,3,14,.62) 58%, transparent 100%);
    pointer-events:none;
  }
  .brand{display:flex;align-items:center;gap:11px;min-width:0;flex:1}
  .brand-mark{
    position:relative;width:27px;height:27px;flex:0 0 auto;
    border:1.5px solid var(--cyan);border-radius:8px;
    transform:rotate(45deg);
    box-shadow:0 0 16px rgba(60,234,255,.45), inset 0 0 12px rgba(60,234,255,.25);
  }
  .brand-mark::after{
    content:"";position:absolute;inset:7px;border-radius:2px;
    background:linear-gradient(135deg,#fff,var(--cyan));box-shadow:0 0 10px var(--cyan);
  }
  .brand-text{display:flex;flex-direction:column;line-height:1;min-width:0}
  .brand-text strong{
    font-size:17px;font-weight:900;font-style:italic;letter-spacing:.18em;
    background:linear-gradient(95deg,#fff,#9df7ff 65%,#51c8ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    white-space:nowrap;
  }
  .brand-text span{
    margin-top:4px;font-size:8px;letter-spacing:.4em;color:#6f89a2;white-space:nowrap;
  }
  .stats{display:flex;align-items:center;gap:clamp(18px,3.4vw,42px);flex:0 0 auto}
  .stat{display:flex;flex-direction:column;gap:2px;text-align:left}
  .stat span{font-size:9px;letter-spacing:.22em;color:#7189a0;font-weight:700}
  .stat b{
    font-size:18px;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:.02em;
    color:#fff;text-shadow:0 0 14px rgba(60,234,255,.4);
  }
  .actions{display:flex;align-items:center;justify-content:flex-end;gap:9px;flex:1;pointer-events:auto}
  .lives{display:flex;gap:2px;margin-right:3px;filter:drop-shadow(0 0 7px rgba(255,79,216,.55))}
  .heart{
    font-size:15px;line-height:1;color:#ff65d4;
    transition:color .25s ease,opacity .25s ease,transform .25s ease;
  }
  .heart.off{color:#273248;opacity:.75;filter:none;transform:scale(.88)}
  .icon-btn{
    width:35px;height:35px;flex:0 0 auto;display:grid;place-items:center;
    border-radius:11px;border:1px solid rgba(160,225,255,.14);
    background:rgba(16,22,42,.55);color:#c9e7f7;
    cursor:pointer;transition:background .18s,border-color .18s,transform .18s,color .18s;
    -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);
  }
  .icon-btn:hover{background:rgba(38,58,88,.7);border-color:rgba(90,235,255,.4);color:#fff;transform:translateY(-1px)}
  .icon-btn:active{transform:translateY(0) scale(.96)}
  .icon-btn:disabled{opacity:.3;cursor:default;transform:none}
  .icon-btn svg{width:18px;height:18px;display:block}
  .icon-btn[aria-pressed="true"]{color:#7d8ca4}
  /* ---------- Overlay & panels ---------- */
  .overlay{
    position:absolute;inset:0;z-index:20;display:grid;place-items:center;
    padding:clamp(12px,3vw,34px);
    background:
      radial-gradient(circle at 50% 42%, rgba(60,30,120,.24), transparent 58%),
      rgba(3,2,10,.62);
    -webkit-backdrop-filter:blur(9px) saturate(1.1);
    backdrop-filter:blur(9px) saturate(1.1);
    transition:opacity .24s ease, visibility .24s ease;
    overflow:auto;
  }
  .overlay.hidden{opacity:0;visibility:hidden;pointer-events:none}
  .panel{
    position:relative;width:min(566px,100%);margin:auto;
    max-height:calc(100dvh - 24px);
    overflow-y:auto;overscroll-behavior:contain;
    padding:clamp(25px,4.2vw,42px);
    border-radius:26px;
    scrollbar-width:thin;scrollbar-color:rgba(120,225,255,.28) transparent;
    border:1px solid var(--panel-line);
    background:linear-gradient(155deg, rgba(26,20,55,.93), rgba(8,6,21,.96) 62%);
    box-shadow:
      0 34px 90px rgba(0,0,0,.62),
      0 0 0 1px rgba(255,255,255,.02) inset,
      0 1px 0 rgba(255,255,255,.09) inset;
    overflow:hidden;
    animation:panelIn .45s cubic-bezier(.2,.9,.25,1) both;
  }
  .panel::before{
    content:"";position:absolute;inset:0;border-radius:inherit;pointer-events:none;
    background:
      radial-gradient(520px 240px at 92% -10%, rgba(255,79,216,.13), transparent 60%),
      radial-gradient(430px 250px at 4% 0%, rgba(60,234,255,.11), transparent 62%);
  }
  .panel::after{
    content:"";position:absolute;top:0;left:12%;right:12%;height:1px;pointer-events:none;
    background:linear-gradient(90deg,transparent,rgba(140,245,255,.75),rgba(255,79,216,.5),transparent);
  }
  .panel > *{position:relative;z-index:1}
  @keyframes panelIn{
    from{opacity:0;transform:translateY(18px) scale(.975)}
    to{opacity:1;transform:none}
  }
  .eyebrow{
    display:flex;align-items:center;gap:9px;
    font-size:10px;font-weight:800;letter-spacing:.24em;color:#8ba3b9;text-transform:uppercase;
  }
  .eyebrow i{
    width:7px;height:7px;border-radius:50%;background:var(--mint);
    box-shadow:0 0 12px var(--mint);animation:pulse 2.2s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:.5;transform:scale(.85)}50%{opacity:1;transform:scale(1.15)}}
  .title{
    margin:17px 0 0;font-size:clamp(48px,9.4vw,78px);line-height:.84;
    font-weight:900;font-style:italic;letter-spacing:-.025em;
  }
  .title span{display:block;width:max-content;max-width:100%}
  .title .line1{
    background:linear-gradient(100deg,#ffffff,#a9f8ff 55%,#31b6ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 0 24px rgba(60,234,255,.36));
  }
  .title .line2{
    margin-top:.07em;
    background:linear-gradient(100deg,#ff9aec,#ff3fca 52%,#9b6bff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
    filter:drop-shadow(0 0 24px rgba(255,63,202,.3));
  }
  .subtitle{margin:17px 0 0;font-size:13px;line-height:1.75;color:#97aabd;max-width:430px}
  .subtitle b{color:#dff6ff;font-weight:700}
  .btn{
    appearance:none;border:0;cursor:pointer;font-weight:800;letter-spacing:.05em;
    border-radius:999px;padding:15px 22px;display:inline-flex;align-items:center;justify-content:center;gap:10px;
    transition:transform .18s ease, box-shadow .18s ease, filter .18s ease, border-color .18s;
    pointer-events:auto;
  }
  .btn-primary{
    width:100%;margin-top:25px;color:#04121a;
    background:linear-gradient(100deg,#7df9ff,#3ceaff 34%,#a696ff 100%);
    box-shadow:0 12px 34px rgba(60,234,255,.22), inset 0 1px 0 rgba(255,255,255,.7);
    font-size:15px;
  }
  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 44px rgba(60,234,255,.32), inset 0 1px 0 rgba(255,255,255,.8)}
  .btn-primary:active{transform:translateY(0) scale(.99)}
  .btn-primary .arrow{font-size:18px;line-height:1;transition:transform .18s ease}
  .btn-primary:hover .arrow{transform:translateX(4px)}
  .btn-ghost{
    background:rgba(255,255,255,.035);border:1px solid rgba(180,225,255,.16);color:#dceeff;
    padding:14px 20px;font-size:13px;
  }
  .btn-ghost:hover{background:rgba(255,255,255,.07);border-color:rgba(160,240,255,.38);transform:translateY(-1px)}
  .menu-meta{
    display:flex;align-items:center;gap:12px;margin-top:15px;
    font-size:11px;letter-spacing:.06em;color:#7e93a8;font-variant-numeric:tabular-nums;
  }
  .menu-meta b{color:#ffd166;font-weight:800;text-shadow:0 0 12px rgba(255,209,102,.35)}
  .menu-meta .sep{width:3px;height:3px;border-radius:50%;background:#40546a}
  .howto{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:22px}
  .howto div{
    padding:12px 11px;border-radius:14px;
    background:rgba(255,255,255,.032);border:1px solid rgba(255,255,255,.06);
  }
  .howto b{display:block;font-size:11px;letter-spacing:.08em;color:#dfeffb;margin-bottom:5px}
  .howto span{display:block;font-size:10px;line-height:1.6;color:#7f93a8}
  .legend{display:flex;flex-wrap:wrap;gap:7px;margin-top:16px}
  .legend span{
    display:inline-flex;align-items:center;gap:6px;padding:5px 9px 5px 6px;
    border-radius:8px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.055);
    font-size:10px;color:#8fa3b7;
  }
  .legend i{
    display:grid;place-items:center;width:17px;height:17px;border-radius:5px;
    font-style:normal;font-size:9px;font-weight:900;color:var(--c);
    background:rgba(255,255,255,.05);
    border:1px solid var(--c);
    box-shadow:0 0 10px rgba(255,255,255,.08);
    background:color-mix(in srgb,var(--c) 13%,transparent);
    border:1px solid color-mix(in srgb,var(--c) 45%,transparent);
    box-shadow:0 0 10px color-mix(in srgb,var(--c) 22%,transparent);
  }
  .legend-note{font-size:10px;color:#5d7186;margin-top:8px;letter-spacing:.04em}
  /* result / pause */
  .compact{width:min(460px,100%);text-align:left}
  .panel h2{
    margin:14px 0 0;font-size:clamp(28px,5vw,40px);line-height:1.12;font-weight:900;letter-spacing:-.01em;
    background:linear-gradient(100deg,#fff,#b9f6ff 60%,#7ed4ff);
    -webkit-background-clip:text;background-clip:text;color:transparent;
  }
  .panel h2.pink{background:linear-gradient(100deg,#fff,#ffa9ea 55%,#ff4fd8);-webkit-background-clip:text;background-clip:text}
  .result-score{
    margin-top:23px;padding:18px 20px;border-radius:17px;
    border:1px solid rgba(120,235,255,.14);
    background:linear-gradient(120deg,rgba(60,234,255,.07),rgba(155,107,255,.06));
    display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;
  }
  .result-score span{display:block;font-size:10px;letter-spacing:.18em;color:#7e97ac;margin-bottom:4px}
  .result-score strong{
    font-size:clamp(38px,7vw,52px);line-height:1;font-variant-numeric:tabular-nums;font-weight:900;
    color:#fff;text-shadow:0 0 28px rgba(60,234,255,.42);letter-spacing:-.02em;
  }
  .result-score em{
    margin-left:auto;font-style:normal;font-size:11px;color:#ffd166;letter-spacing:.04em;
    padding-bottom:4px;font-variant-numeric:tabular-nums;
  }
  .result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:9px}
  .result-grid div{padding:13px 14px;border-radius:13px;background:rgba(255,255,255,.032);border:1px solid rgba(255,255,255,.055)}
  .result-grid span{display:block;font-size:9px;letter-spacing:.14em;color:#758da3;margin-bottom:5px}
  .result-grid b{font-size:15px;font-weight:800;color:#e8f8ff;font-variant-numeric:tabular-nums}
  .btn-row{display:flex;gap:9px;margin-top:21px}
  .btn-row .btn{flex:1;margin-top:0}
  .pause-note{font-size:12px;color:#829ab0;line-height:1.7;margin:13px 0 0}
  @media (max-width:760px){
    .hud{gap:10px;padding:max(10px,env(safe-area-inset-top)) 14px 10px}
    .brand{gap:8px}
    .brand-mark{width:23px;height:23px;border-radius:7px}
    .brand-mark::after{inset:6px}
    .brand-text strong{font-size:14px;letter-spacing:.1em}
    .brand-text span{font-size:7px;letter-spacing:.26em;margin-top:3px}
    .stats{gap:16px}
    .stat b{font-size:15px}
    .stat span{font-size:8px;letter-spacing:.12em}
    .actions{gap:6px}
    .icon-btn{width:32px;height:32px;border-radius:9px}
    .icon-btn svg{width:16px;height:16px}
    .heart{font-size:13px}
  }
  @media (max-width:560px){
    .brand-text span{display:none}
    .stat.best{display:none}
    .heart.off{display:none}
    .lives{gap:1px;margin-right:1px}
    .howto{grid-template-columns:repeat(3,1fr);gap:6px}
    .howto div{padding:10px 8px}
    .howto b{font-size:10px}
    .howto span{font-size:9px}
    .legend{gap:5px}
    .legend span{font-size:9px;padding:4px 7px 4px 5px}
    .result-grid{grid-template-columns:1fr 1fr}
    .result-grid div:last-child{display:none}
    .btn-row{flex-direction:column}
  }
  @media (max-width:410px){
    .stats{margin-left:auto;margin-right:auto}
    .actions{flex:0 0 auto}
    .panel{padding:23px 19px;border-radius:21px}
    .title{font-size:46px}
    .subtitle{font-size:12px}
  }
  @media (max-width:375px){
    .brand-text{display:none}
  }
  @media (max-height:700px){
    .title{font-size:clamp(38px,8vh,56px);margin-top:12px}
    .subtitle{margin-top:11px;font-size:12px}
    .btn-primary{margin-top:16px;padding:13px 20px}
    .howto{margin-top:14px}
    .legend{display:none}
    .menu-meta{margin-top:11px}
  }
  @media (prefers-reduced-motion:reduce){
    *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  }
</style>
</head>
<body>
<div id="app">
  <canvas id="game" aria-label="霓虹破碎者游戏画面"></canvas>
  <header class="hud" id="hud">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true"></div>
      <div class="brand-text">
        <strong>NEON</strong>
        <span>BREAKER</span>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><span>得分</span><b id="score">0</b></div>
      <div class="stat"><span>关卡</span><b id="level">01</b></div>
      <div class="stat best"><span>最高</span><b id="best">0</b></div>
    </div>
    <div class="actions">
      <div class="lives" id="lives" aria-label="剩余生命"></div>
      <button class="icon-btn" id="soundBtn" type="button" aria-label="声音开关" aria-pressed="false"></button>
      <button class="icon-btn" id="pauseBtn" type="button" aria-label="暂停游戏" disabled>
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="7" y="5" width="3.2" height="14" rx="1.5" fill="currentColor"/><rect x="13.8" y="5" width="3.2" height="14" rx="1.5" fill="currentColor"/></svg>
      </button>
    </div>
  </header>
  <div class="overlay" id="overlay" aria-live="polite"></div>
</div>
<script>
(function () {
  'use strict';
  /* =========================================================
     NEON BREAKER — a single-file neon brick breaker
     ========================================================= */
  var canvas = document.getElementById('game');
  var ctx = canvas.getContext('2d');
  var hudEl = document.getElementById('hud');
  var overlay = document.getElementById('overlay');
  var scoreEl = document.getElementById('score');
  var levelEl = document.getElementById('level');
  var bestEl = document.getElementById('best');
  var livesEl = document.getElementById('lives');
  var soundBtn = document.getElementById('soundBtn');
  var pauseBtn = document.getElementById('pauseBtn');
  var TAU = Math.PI * 2;
  var STORE_BEST = 'neon-breaker-best-v1';
  var STORE_MUTE = 'neon-breaker-muted-v1';
  var FONT = '"Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif';
  var PAD = 14;
  var G = {
    W: 0, H: 0, dpr: 1,
    field: { x: 0, y: 0, w: 0, h: 0 },
    state: 'menu',
    prevState: 'ready',
    level: 1, score: 0, best: 0, lives: 3,
    combo: 0, comboTimer: 0, maxCombo: 0,
    balls: [], bricks: [], powerups: [], particles: [], bullets: [], texts: [],
    cols: 10, rows: 6, brickW: 80, brickH: 24, gap: 8, gridTop: 120,
    paddle: { x: 0, y: 0, w: 120, h: 14, targetX: 0, vx: 0, prevX: 0 },
    buffs: { expand: 0, slow: 0, laser: 0 },
    laserTimer: 0,
    shake: 0, flash: 0,
    time: 0, last: 0,
    clearTimer: 0,
    banner: null,
    keys: { left: false, right: false },
    muted: false,
    audio: null,
    master: null,
    bg: null,
    stars: [],
    brickSprites: new Map(),
    coarse: false,
    overlayToken: 0
  };
  /* ---------------- helpers ---------------- */
  function clamp(v, a, b) { return Math.min(b, Math.max(a, v)); }
  function lerp(a, b, t) { return a + (b - a) * t; }
  function rand(a, b) { return a + Math.random() * (b - a); }
  function fmt(n) { return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ','); }
  function pad2(n) { return String(n).padStart(2, '0'); }
  function easeOutCubic(t) { return 1 - Math.pow(1 - t, 3); }
  function rr(g, x, y, w, h, r) {
    r = Math.min(r, w / 2, h / 2);
    g.beginPath();
    g.moveTo(x + r, y);
    g.arcTo(x + w, y, x + w, y + h, r);
    g.arcTo(x + w, y + h, x, y + h, r);
    g.arcTo(x, y + h, x, y, r);
    g.arcTo(x, y, x + w, y, r);
    g.closePath();
  }
  function mulberry32(seed) {
    var a = seed >>> 0;
    return function () {
      a |= 0; a = (a + 0x6D2B79F5) | 0;
      var t = Math.imul(a ^ (a >>> 15), 1 | a);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };
  }
  function loadStore() {
    try {
      G.best = parseInt(localStorage.getItem(STORE_BEST), 10) || 0;
      G.muted = localStorage.getItem(STORE_MUTE) === '1';
    } catch (e) { /* storage unavailable */ }
  }
  function saveBest() {
    try { localStorage.setItem(STORE_BEST, String(G.best)); } catch (e) {}
  }
  /* ---------------- audio ---------------- */
  function initAudio() {
    if (G.audio) {
      if (G.audio.state === 'suspended') { G.audio.resume().catch(function () {}); }
      return;
    }
    var AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return;
    try {
      G.audio = new AC();
      G.master = G.audio.createGain();
      G.master.gain.value = G.muted ? 0 : 0.5;
      G.master.connect(G.audio.destination);
    } catch (e) { G.audio = null; }
  }
  function sfx(name) {
    if (!G.audio || G.muted) return;
    var t0 = G.audio.currentTime;
    function tone(freq, dur, type, vol, slide, delay) {
      if (!G.audio) return;
      delay = delay || 0;
      var o = G.audio.createOscillator();
      var g = G.audio.createGain();
      o.type = type || 'sine';
      o.frequency.setValueAtTime(Math.max(20, freq), t0 + delay);
      if (slide) {
        o.frequency.exponentialRampToValueAtTime(Math.max(20, slide), t0 + delay + dur);
      }
      g.gain.setValueAtTime(0.0001, t0 + delay);
      g.gain.linearRampToValueAtTime(vol, t0 + delay + 0.008);
      g.gain.exponentialRampToValueAtTime(0.0001, t0 + delay + dur);
      o.connect(g);
      g.connect(G.master);
      o.start(t0 + delay);
      o.stop(t0 + delay + dur + 0.03);
    }
    switch (name) {
      case 'launch':
        tone(300, 0.14, 'triangle', 0.10, 720);
        break;
      case 'paddle':
        tone(190, 0.055, 'square', 0.055, 260);
        break;
      case 'wall':
        tone(320, 0.035, 'sine', 0.035, 260);
        break;
      case 'brick':
        tone(430 + Math.min(G.combo, 12) * 22, 0.055, 'triangle', 0.055, 520);
        break;
      case 'break':
        tone(620, 0.08, 'square', 0.05, 880);
        tone(930, 0.07, 'triangle', 0.035, 1240, 0.015);
        break;
      case 'power':
        tone(660, 0.10, 'sine', 0.08, 780);
        tone(880, 0.10, 'sine', 0.07, 1020, 0.07);
        tone(1180, 0.15, 'sine', 0.06, 1420, 0.14);
        break;
      case 'combo':
        tone(880, 0.07, 'triangle', 0.055, 1100);
        tone(1320, 0.10, 'triangle', 0.045, 1560, 0.06);
        break;
      case 'laser':
        tone(1200, 0.035, 'square', 0.018, 700);
        break;
      case 'lose':
        tone(220, 0.3, 'sawtooth', 0.075, 80);
        tone(130, 0.45, 'sine', 0.06, 50, 0.08);
        break;
      case 'clear':
        [523, 659, 784, 1046].forEach(function (f, i) {
          tone(f, 0.2, 'triangle', 0.065, 0, i * 0.085);
        });
        break;
      case 'over':
        tone(300, 0.3, 'sawtooth', 0.06, 120);
        tone(180, 0.45, 'triangle', 0.05, 70, 0.18);
        break;
      case 'start':
        [330, 440, 660].forEach(function (f, i) {
          tone(f, 0.14, 'triangle', 0.055, 0, i * 0.06);
        });
        break;
    }
  }
  function toggleMute() {
    G.muted = !G.muted;
    try { localStorage.setItem(STORE_MUTE, G.muted ? '1' : '0'); } catch (e) {}
    if (G.master && G.audio) {
      var now = G.audio.currentTime;
      G.master.gain.cancelScheduledValues(now);
      G.master.gain.setTargetAtTime(G.muted ? 0 : 0.5, now, 0.02);
    }
    if (!G.muted) initAudio();
    renderSoundBtn();
  }
  var ICON_SOUND = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.4h3.3L12 5.5v13L7.3 14.6H4z" fill="currentColor"/><path d="M15.6 8.6a4.9 4.9 0 010 6.8M18.4 5.9a8.7 8.7 0 010 12.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
  var ICON_MUTE = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9.4h3.3L12 5.5v13L7.3 14.6H4z" fill="currentColor"/><path d="M15.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>';
  function renderSoundBtn() {
    soundBtn.innerHTML = G.muted ? ICON_MUTE : ICON_SOUND;
    soundBtn.setAttribute('aria-pressed', G.muted ? 'true' : 'false');
    soundBtn.setAttribute('aria-label', G.muted ? '开启声音' : '关闭声音');
  }
  /* ---------------- layout ---------------- */
  function desiredPaddleW() {
    return clamp(G.field.w * 0.165, 86, 152) * (G.buffs.expand > 0 ? 1.55 : 1);
  }
  function ballRadius() {
    return clamp(G.field.w * 0.0075, 5.5, 8.2);
  }
  function computeGrid() {
    var f = G.field;
    G.cols = f.w < 470 ? 7 : f.w < 680 ? 9 : f.w < 900 ? 10 : 12;
    G.rows = 6 + (f.w < 560 && f.h > 540 ? 1 : 0) + Math.min(2, Math.floor((G.level - 1) / 3));
    G.gap = clamp(f.w * 0.008, 4, 9);
    G.brickW = (f.w - G.gap * (G.cols - 1)) / G.cols;
    G.brickH = clamp(G.brickW * 0.36, 18, 30);
    G.gridTop = f.y + clamp(f.h * 0.055, 36, 54);
  }
  function resize() {
    var oldField = { x: G.field.x, y: G.field.y, w: G.field.w, h: G.field.h };
    var hadField = G.field.w > 0;
    G.W = window.innerWidth;
    G.H = window.innerHeight;
    G.dpr = clamp(window.devicePixelRatio || 1, 1, 2);
    canvas.width = Math.max(1, Math.round(G.W * G.dpr));
    canvas.height = Math.max(1, Math.round(G.H * G.dpr));
    canvas.style.width = G.W + 'px';
    canvas.style.height = G.H + 'px';
    ctx.setTransform(G.dpr, 0, 0, G.dpr, 0, 0);
    var hudRect = hudEl.getBoundingClientRect();
    var x = clamp(G.W * 0.035, 12, 46);
    var w = G.W - x * 2;
    if (w > 1180) { x += (w - 1180) / 2; w = 1180; }
    var top = Math.max(hudRect.bottom + 7, 72);
    var bottomPad = G.W < 560 ? clamp(G.H * 0.15, 88, 148) : clamp(G.H * 0.035, 12, 38);
    var h = Math.max(220, G.H - top - bottomPad);
    G.field.x = x;
    G.field.y = top;
    G.field.w = w;
    G.field.h = h;
    if (hadField && G.bricks.length) {
      var sx = w / oldField.w;
      var sy = h / oldField.h;
      G.bricks.forEach(function (b) {
        b.x = x + (b.x - oldField.x) * sx;
        b.y = top + (b.y - oldField.y) * sy;
        b.w *= sx;
        b.h *= sy;
      });
      G.balls.forEach(function (b) {
        b.x = x + (b.x - oldField.x) * sx;
        b.y = top + (b.y - oldField.y) * sy;
        b.r = ballRadius();
        b.trail.length = 0;
      });
      G.powerups.forEach(function (p) {
        p.x = x + (p.x - oldField.x) * sx;
        p.y = top + (p.y - oldField.y) * sy;
      });
    }
    var p = G.paddle;
    var ratio = 0.5;
    if (hadField) ratio = clamp(((p.x + p.w / 2) - oldField.x) / oldField.w, 0, 1);
    p.w = desiredPaddleW();
    p.h = clamp(w * 0.014, 12, 16);
    p.y = top + h - 28;
    p.x = clamp(x + ratio * w - p.w / 2, x, x + w - p.w);
    p.targetX = p.x + p.w / 2;
    p.prevX = p.x;
    if (G.balls.length === 0) {
      p.x = x + (w - p.w) / 2;
      p.targetX = p.x + p.w / 2;
    }
    G.brickSprites.clear();
    buildBG();
    makeStars();
    if (G.state === 'menu') {
      p.w = desiredPaddleW();
      p.x = x + (w - p.w) / 2;
      p.y = top + h - 28;
      p.targetX = p.x + p.w / 2;
    }
  }
  function makeStars() {
    G.stars = [];
    var n = clamp(Math.round(G.W * G.H / 13000), 34, 120);
    for (var i = 0; i < n; i++) {
      G.stars.push({
        x: Math.random() * G.W,
        y: Math.random() * G.H,
        r: rand(0.5, 1.9),
        phase: Math.random() * TAU,
        speed: rand(0.5, 1.9),
        warm: Math.random() < 0.18
      });
    }
  }
  function buildBG() {
    var W = G.W, H = G.H, dpr = G.dpr;
    var c = document.createElement('canvas');
    c.width = Math.max(1, Math.round(W * dpr));
    c.height = Math.max(1, Math.round(H * dpr));
    var g = c.getContext('2d');
    g.setTransform(dpr, 0, 0, dpr, 0, 0);
    var grad = g.createLinearGradient(0, 0, W * 0.35, H);
    grad.addColorStop(0, '#05030f');
    grad.addColorStop(0.48, '#08051b');
    grad.addColorStop(1, '#0b0418');
    g.fillStyle = grad;
    g.fillRect(0, 0, W, H);
    function glow(x, y, r, color) {
      var rg = g.createRadialGradient(x, y, 0, x, y, r);
      rg.addColorStop(0, color);
      rg.addColorStop(1, 'rgba(0,0,0,0)');
      g.fillStyle = rg;
      g.fillRect(x - r, y - r, r * 2, r * 2);
    }
    glow(W * 0.18, H * 0.24, Math.max(W, H) * 0.42, 'rgba(82,36,160,.20)');
    glow(W * 0.88, H * 0.55, Math.max(W, H) * 0.4, 'rgba(0,120,160,.13)');
    glow(W * 0.52, H * 0.02, Math.max(W, H) * 0.28, 'rgba(255,40,180,.07)');
    // synthwave floor
    var horizon = H * 0.62;
    g.lineWidth = 1;
    g.strokeStyle = 'rgba(75,170,255,.055)';
    for (var i = 0; i < 13; i++) {
      var t = i / 12;
      var y = horizon + Math.pow(t, 1.7) * (H - horizon);
      g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke();
    }
    for (var j = -12; j <= 12; j++) {
      g.beginPath();
      g.moveTo(W / 2 + j * W * 0.045, horizon);
      g.lineTo(W / 2 + j * W * 0.42, H);
      g.stroke();
    }
    var hz = g.createLinearGradient(0, horizon - 40, 0, horizon + 80);
    hz.addColorStop(0, 'rgba(90,40,180,0)');
    hz.addColorStop(0.6, 'rgba(90,60,210,.055)');
    hz.addColorStop(1, 'rgba(90,40,180,0)');
    g.fillStyle = hz;
    g.fillRect(0, horizon - 40, W, 120);
    // faint star dust baked into bg
    for (var k = 0; k < 70; k++) {
      g.fillStyle = 'rgba(190,235,255,' + rand(0.025, 0.09).toFixed(3) + ')';
      g.fillRect(Math.random() * W, Math.random() * H, 1, 1);
    }
    G.bg = c;
  }
  /* ---------------- game setup ---------------- */
  function resetBuffs() {
    G.buffs.expand = 0;
    G.buffs.slow = 0;
    G.buffs.laser = 0;
    G.laserTimer = 0;
  }
  function makeAttachedBall() {
    var p = G.paddle;
    var r = ballRadius();
    return {
      x: p.x + p.w / 2,
      y: p.y - r - 3,
      vx: 0, vy: 0, r: r,
      attached: true,
      trail: []
    };
  }
  function attachBall() {
    G.balls = [makeAttachedBall()];
    G.combo = 0;
    G.comboTimer = 0;
    G.state = 'ready';
    updateHud();
  }
  function buildStage() {
    computeGrid();
    G.bricks = generateBricks();
    G.powerups = [];
    G.bullets = [];
    G.texts = [];
    G.particles = [];
    resetBuffs();
    var p = G.paddle;
    p.w = desiredPaddleW();
    p.x = G.field.x + (G.field.w - p.w) / 2;
    p.y = G.field.y + G.field.h - 28;
    p.targetX = p.x + p.w / 2;
    p.prevX = p.x;
    p.vx = 0;
    G.balls = [makeAttachedBall()];
    G.combo = 0;
    G.comboTimer = 0;
    G.clearTimer = 0;
    G.state = 'ready';
    G.banner = {
      title: 'STAGE ' + pad2(G.level),
      sub: G.level === 1 ? '击碎全部光砖 · 接住掉落道具' : '球速提升 · 保持连击',
      t: 0, dur: 1.5
    };
    updateHud();
  }
  function generateBricks() {
    var out = [];
    var f = G.field;
    var rows = G.rows, cols = G.cols;
    var rng = mulberry32((0x9E3779B9 ^ Math.imul(G.level, 2654435761)) >>> 0);
    var p2 = clamp(0.15 + G.level * 0.018, 0.15, 0.32);
    var p3 = clamp(0.025 + G.level * 0.009, 0.025, 0.12);
    for (var r = 0; r < rows; r++) {
      for (var c = 0; c < cols; c++) {
        if (!patternOn(r, c, rows, cols, G.level, rng)) continue;
        var roll = rng();
        var hp = 1;
        if (roll < p3) hp = 3;
        else if (roll < p3 + p2) hp = 2;
        out.push({
          col: c, row: r,
          x: f.x + c * (G.brickW + G.gap),
          y: G.gridTop + r * (G.brickH + G.gap),
          w: G.brickW, h: G.brickH,
          hp: hp, maxHp: hp, alive: true, flash: 0
        });
      }
    }
    return out;
  }
  function patternOn(r, c, rows, cols, level, rng) {
    var p = (level - 1) % 5;
    var mid = (cols - 1) / 2;
    var dc = Math.abs(c - mid) / (mid || 1);
    var dr = Math.abs(r - (rows - 1) / 2) / ((rows - 1) / 2 || 1);
    switch (p) {
      case 0: // cascading full wall with small gaps
        if (r > 1 && (c + r * 2) % 7 === 0) return false;
        return !(r === rows - 1 && c % 3 === 1);
      case 1: // checkerboard
        return (r + c) % 2 === 0 || r === 0;
      case 2: // pyramid
        return Math.abs(c - mid) <= Math.min(mid, r + 1.6);
      case 3: // diamond ring
        return dc + dr <= 1.02 && dc + dr >= 0.24;
      case 4: // fortress
        if (r === 0 || r === rows - 1) return c % 5 !== 2;
        return c % 4 !== 3 && !(r === 2 && c > mid - 1 && c < mid + 1);
      default:
        return true;
    }
  }
  function startGame() {
    initAudio();
    G.score = 0;
    G.lives = 3;
    G.level = 1;
    G.maxCombo = 0;
    G.destroyed = 0;
    G.combo = 0;
    G.comboTimer = 0;
    G.flash = 0;
    G.shake = 0;
    resetBuffs();
    buildStage();
    hideOverlay();
    pauseBtn.disabled = false;
    sfx('start');
  }
  function showMenu() {
    G.state = 'menu';
    G.score = 0;
    G.level = 1;
    G.lives = 3;
    G.combo = 0;
    G.comboTimer = 0;
    G.maxCombo = 0;
    G.bricks = [];
    G.balls = [];
    G.powerups = [];
    G.bullets = [];
    G.texts = [];
    G.particles = [];
    G.banner = null;
    G.clearTimer = 0;
    G.shake = 0;
    G.flash = 0;
    resetBuffs();
    var p = G.paddle;
    p.w = desiredPaddleW();
    p.x = G.field.x + (G.field.w - p.w) / 2;
    p.y = G.field.y + G.field.h - 28;
    p.targetX = p.x + p.w / 2;
    updateHud();
    showOverlay(menuHTML());
  }
  function hideOverlay() {
    overlay.classList.add('hidden');
    var token = ++G.overlayToken;
    window.setTimeout(function () {
      if (token === G.overlayToken) overlay.innerHTML = '';
    }, 260);
  }
  function showOverlay(html) {
    G.overlayToken++;
    overlay.innerHTML = html;
    overlay.classList.remove('hidden');
  }
  /* ---------------- HUD & panels ---------------- */
  function updateHud() {
    scoreEl.textContent = fmt(G.score);
    bestEl.textContent = fmt(G.best);
    levelEl.textContent = pad2(G.level);
    var html = '';
    for (var i = 0; i < 5; i++) {
      html += '<span class="heart' + (i < G.lives ? '' : ' off') + '">♥</span>';
    }
    livesEl.innerHTML = html;
    livesEl.setAttribute('aria-label', '剩余生命 ' + G.lives);
    pauseBtn.disabled = !(G.state === 'playing' || G.state === 'ready' || G.state === 'paused');
  }
  function addScore(n) {
    G.score += Math.round(n);
    if (G.score > G.best) {
      G.best = G.score;
      bestEl.textContent = fmt(G.best);
    }
    scoreEl.textContent = fmt(G.score);
  }
  function menuHTML() {
    return '' +
      '<div class="panel">' +
        '<div class="eyebrow"><i></i>Arcade mode · 无尽关卡</div>' +
        '<h1 class="title"><span class="line1">NEON</span><span class="line2">BREAKER</span></h1>' +
        '<p class="subtitle">霓虹破碎者。控制挡板，击碎全部光砖；接住能量核心，在球坠落之前清空每一层。</p>' +
        '<button class="btn btn-primary" type="button" data-action="start">开始游戏<span class="arrow">→</span></button>' +
        '<div class="menu-meta"><span>最高分 <b>' + fmt(G.best) + '</b></span><span class="sep"></span><span>无尽模式</span><span class="sep"></span><span>v1.0</span></div>' +
        '<div class="howto">' +
          '<div><b>移动挡板</b><span>' + (G.coarse ? '手指左右拖动' : '鼠标拖动或<br>← → 键') + '</span></div>' +
          '<div><b>发射光球</b><span>' + (G.coarse ? '轻触画面<br>即可发球' : '点击画面<br>或按空格') + '</span></div>' +
          '<div><b>暂停</b><span>' + (G.coarse ? '点击右上角<br>暂停按钮' : 'P / ESC<br>可随时暂停') + '</span></div>' +
        '</div>' +
        '<div class="legend">' +
          '<span><i style="--c:#3ceaff">W</i>加宽</span>' +
          '<span><i style="--c:#ff4fd8">3×</i>多球</span>' +
          '<span><i style="--c:#8fa8ff">S</i>减速</span>' +
          '<span><i style="--c:#ffd166">L</i>激光</span>' +
          '<span><i style="--c:#6dffb8">♥</i>生命</span>' +
        '</div>' +
        '<div class="legend-note">击碎砖块有几率掉落道具 · 连击越高得分越多</div>' +
      '</div>';
  }
  function pauseHTML() {
    return '' +
      '<div class="panel compact">' +
        '<div class="eyebrow"><i style="background:#ffd166;box-shadow:0 0 12px #ffd166"></i>Paused</div>' +
        '<h2>暂停中</h2>' +
        '<p class="pause-note">光球会等你回来。<br>继续挑战，或重新开始本局。</p>' +
        '<div class="btn-row" style="margin-top:22px">' +
          '<button class="btn btn-primary" type="button" data-action="resume" style="margin-top:0">继续游戏</button>' +
          '<button class="btn btn-ghost" type="button" data-action="restart">重新开始</button>' +
        '</div>' +
        '<div class="btn-row" style="margin-top:8px">' +
          '<button class="btn btn-ghost" type="button" data-action="menu" style="flex:1">返回首页</button>' +
        '</div>' +
      '</div>';
  }
  function overHTML() {
    return '' +
      '<div class="panel compact">' +
        '<div class="eyebrow"><i style="background:#ff4fd8;box-shadow:0 0 12px #ff4fd8"></i>Game over</div>' +
        '<h2 class="pink">光球坠落了</h2>' +
        '<p class="pause-note">霓虹不会熄灭——调整节奏，再来一局。</p>' +
        '<div class="result-score"><div><span>本局得分</span><strong>' + fmt(G.score) + '</strong></div>' +
          '<em>最高 ' + fmt(G.best) + '</em></div>' +
        '<div class="result-grid">' +
          '<div><span>到达关卡</span><b>STAGE ' + pad2(G.level) + '</b></div>' +
          '<div><span>最高连击</span><b>×' + G.maxCombo + '</b></div>' +
          '<div><span>拆除光砖</span><b>' + fmt(G.destroyed || 0) + '</b></div>' +
        '</div>' +
        '<div class="btn-row">' +
          '<button class="btn btn-primary" type="button" data-action="restart" style="margin-top:0;width:auto">再来一局<span class="arrow">→</span></button>' +
          '<button class="btn btn-ghost" type="button" data-action="menu">返回首页</button>' +
        '</div>' +
      '</div>';
  }
  function endGame() {
    G.state = 'over';
    G.best = Math.max(G.best, G.score);
    saveBest();
    updateHud();
    showOverlay(overHTML());
    sfx('over');
  }
  function pauseGame() {
    if (!(G.state === 'playing' || G.state === 'ready')) return;
    G.prevState = G.state;
    G.state = 'paused';
    G.best = Math.max(G.best, G.score);
    saveBest();
    updateHud();
    showOverlay(pauseHTML());
  }
  function resumeGame() {
    if (G.state !== 'paused') return;
    G.state = G.prevState || 'ready';
    hideOverlay();
    updateHud();
    G.last = performance.now();
  }
  /* ---------------- stage / scoring ---------------- */
  function comboMult() { return comboMultFor(G.combo); }
  function comboMultFor(combo) { return Math.min(5, 1 + Math.floor(combo / 4)); }
  function incCombo() {
    var before = comboMult();
    G.combo++;
    G.comboTimer = 3.4;
    G.maxCombo = Math.max(G.maxCombo, G.combo);
    var after = comboMult();
    if (after > before) {
      addText(G.field.x + G.field.w / 2, G.field.y + G.field.h * 0.36, '连击 ×' + after, '#ffd166', 20);
      sfx('combo');
      G.shake = Math.max(G.shake, 3);
    }
  }
  function damageBrick(br, amount, fromBullet) {
    if (!br.alive) return;
    br.hp -= amount;
    br.flash = 1;
    var color = brickColor(br.maxHp);
    if (br.hp > 0) {
      if (!fromBullet) incCombo();
      addScore(8 * comboMult());
      spawnSparks(br.x + br.w / 2, br.y + br.h / 2, color, 4, fromBullet ? 60 : 120);
      G.shake = Math.max(G.shake, 1.8);
      if (!fromBullet) sfx('brick');
      return;
    }
    br.alive = false;
    G.destroyed = (G.destroyed || 0) + 1;
    if (!fromBullet) incCombo();
    var mult = comboMult();
    var gain = Math.round((24 * br.maxHp + 8) * mult);
    addScore(gain);
    addText(br.x + br.w / 2, br.y + br.h / 2, '+' + gain, color, br.maxHp >= 3 ? 17 : 14);
    spawnBurst(br.x + br.w / 2, br.y + br.h / 2, color, 14, 250);
    G.shake = Math.max(G.shake, 4.5);
    sfx('break');
    if (Math.random() < 0.16) dropPowerup(br);
    if (!G.bricks.some(function (b) { return b.alive; })) stageClear();
  }
  function stageClear() {
    if (G.state !== 'playing') return;
    G.state = 'clear';
    var bonus = 260 * G.level + G.lives * 120;
    addScore(bonus);
    G.best = Math.max(G.best, G.score);
    saveBest();
    G.clearTimer = 2.05;
    G.banner = {
      title: 'STAGE ' + pad2(G.level) + ' CLEAR',
      sub: '清空奖励 +' + fmt(bonus),
      t: 0, dur: 2.0
    };
    sfx('clear');
    for (var i = 0; i < 46; i++) {
      G.particles.push({
        x: rand(G.field.x, G.field.x + G.field.w),
        y: rand(G.field.y + 30, G.field.y + 90),
        vx: rand(-70, 70),
        vy: rand(-40, 170),
        g: 150,
        life: rand(1.2, 2.2),
        max: 2.2,
        size: rand(2, 4.4),
        color: ['#3ceaff', '#ff4fd8', '#ffd166', '#6dffb8', '#9b6bff'][i % 5],
        spin: rand(-4, 4),
        angle: rand(0, TAU),
        square: true
      });
    }
    updateHud();
  }
  function loseLife() {
    G.lives--;
    G.flash = 1;
    G.shake = 18;
    G.combo = 0;
    G.comboTimer = 0;
    resetBuffs();
    sfx('lose');
    updateHud();
    if (G.lives <= 0) {
      endGame();
      return;
    }
    attachBall();
    G.banner = {
      title: 'BALL LOST',
      sub: '剩余 ' + G.lives + ' 条生命',
      t: 0, dur: 1.15
    };
  }
  /* ---------------- powerups ---------------- */
  var PU_META = {
    expand: { color: '#3ceaff', label: '加宽', buff: 'expand' },
    multi: { color: '#ff4fd8', label: '多球' },
    slow: { color: '#8fa8ff', label: '减速', buff: 'slow' },
    laser: { color: '#ffd166', label: '激光', buff: 'laser' },
    life: { color: '#6dffb8', label: '生命 +1' }
  };
  function dropPowerup(br) {
    if (G.powerups.length >= 4) return;
    var r = Math.random();
    var type;
    if (r < 0.27) type = 'expand';
    else if (r < 0.51) type = 'multi';
    else if (r < 0.69) type = 'slow';
    else if (r < 0.92) type = 'laser';
    else type = 'life';
    G.powerups.push({
      x: br.x + br.w / 2,
      y: br.y + br.h / 2,
      vy: rand(95, 145),
      t: 0,
      type: type,
      r: 13,
      dead: false
    });
  }
  function applyPowerup(p) {
    var meta = PU_META[p.type];
    var f = G.field;
    if (p.type === 'expand') G.buffs.expand = 10;
    else if (p.type === 'slow') G.buffs.slow = 7;
    else if (p.type === 'laser') { G.buffs.laser = 8; G.laserTimer = 0; }
    else if (p.type === 'multi') splitBalls();
    else if (p.type === 'life') G.lives = Math.min(5, G.lives + 1);
    addText(p.x, p.y - 10, meta.label, meta.color, 15);
    spawnBurst(p.x, p.y, meta.color, 12, 190);
    sfx('power');
    G.shake = Math.max(G.shake, 3);
    updateHud();
  }
  function splitBalls() {
    var base = G.balls.filter(function (b) { return !b.attached; });
    if (!base.length) return;
    var add = [];
    for (var i = 0; i < base.length; i++) {
      if (G.balls.length + add.length >= 6) break;
      var b = base[i];
      var ang = Math.atan2(b.vy, b.vx);
      var spd = Math.hypot(b.vx, b.vy) || ballSpeed();
      [-0.42, 0.42].forEach(function (off) {
        if (G.balls.length + add.length >= 6) return;
        add.push({
          x: b.x, y: b.y, r: ballRadius(),
          vx: Math.cos(ang + off) * spd,
          vy: Math.sin(ang + off) * spd,
          attached: false, trail: []
        });
      });
    }
    G.balls = G.balls.concat(add);
  }
  /* ---------------- launch & physics ---------------- */
  function ballSpeed() {
    var base = clamp(305 + G.field.w * 0.185, 340, 545);
    if (G.W < 560) base = Math.max(base, 445);
    base += (G.level - 1) * 13;
    base = Math.min(base, 760);
    return base * (G.buffs.slow > 0 ? 0.72 : 1);
  }
  function launch() {
    if (G.state !== 'ready') return;
    var spd = ballSpeed();
    var ang = rand(-0.3, 0.3);
    var p = G.paddle;
    G.balls.forEach(function (b) {
      b.attached = false;
      b.x = p.x + p.w / 2;
      b.y = p.y - b.r - 3;
      b.vx = Math.sin(ang) * spd;
      b.vy = -Math.cos(ang) * spd;
      b.trail.length = 0;
    });
    G.state = 'playing';
    updateHud();
    sfx('launch');
  }
  function updatePaddle(dt) {
    var p = G.paddle, f = G.field;
    var targetW = desiredPaddleW();
    if (Math.abs(p.w - targetW) > 0.2) {
      var cx = p.x + p.w / 2;
      p.w = lerp(p.w, targetW, 1 - Math.exp(-11 * dt));
      p.x = clamp(cx - p.w / 2, f.x, f.x + f.w - p.w);
    }
    if (G.keys.left) p.targetX -= 980 * dt;
    if (G.keys.right) p.targetX += 980 * dt;
    p.targetX = clamp(p.targetX, f.x + p.w / 2, f.x + f.w - p.w / 2);
    var goalX = p.targetX - p.w / 2;
    p.x = lerp(p.x, goalX, 1 - Math.exp(-26 * dt));
    p.x = clamp(p.x, f.x, f.x + f.w - p.w);
    p.vx = (p.x - p.prevX) / Math.max(dt, 0.0001);
    p.prevX = p.x;
  }
  function physics(dt) {
    var f = G.field, p = G.paddle;
    var i;
    for (i = 0; i < G.balls.length; i++) {
      var b = G.balls[i];
      if (b.attached || b.dead) continue;
      var spd = ballSpeed();
      var mag = Math.hypot(b.vx, b.vy) || 1;
      b.vx = b.vx / mag * spd;
      b.vy = b.vy / mag * spd;
      b.x += b.vx * dt;
      b.y += b.vy * dt;
      // side walls
      if (b.x - b.r < f.x) { b.x = f.x + b.r; b.vx = Math.abs(b.vx); sfx('wall'); }
      else if (b.x + b.r > f.x + f.w) { b.x = f.x + f.w - b.r; b.vx = -Math.abs(b.vx); sfx('wall'); }
      // ceiling
      if (b.y - b.r < f.y) { b.y = f.y + b.r; b.vy = Math.abs(b.vy); sfx('wall'); }
      // paddle
      if (b.vy > 0 && b.y + b.r >= p.y && b.y - b.r <= p.y + p.h + 4) {
        var nx = clamp(b.x, p.x, p.x + p.w);
        var ny = clamp(b.y, p.y, p.y + p.h);
        var pdx = b.x - nx, pdy = b.y - ny;
        if (pdx * pdx + pdy * pdy <= b.r * b.r) {
          var rel = clamp((b.x - (p.x + p.w / 2)) / (p.w / 2), -1, 1);
          var angle = rel * 1.04;
          var spd2 = ballSpeed();
          b.vx = Math.sin(angle) * spd2 + clamp(p.vx * 0.13, -130, 130);
          b.vy = -Math.abs(Math.cos(angle) * spd2);
          var m2 = Math.hypot(b.vx, b.vy) || 1;
          b.vx = b.vx / m2 * spd2;
          b.vy = b.vy / m2 * spd2;
          b.y = p.y - b.r - 0.6;
          G.combo = 0;
          G.comboTimer = 0;
          G.shake = Math.max(G.shake, 1.6);
          spawnSparks(b.x, p.y - 2, '#3ceaff', 6, 150);
          sfx('paddle');
        }
      }
      // bricks
      for (var j = 0; j < G.bricks.length; j++) {
        var br = G.bricks[j];
        if (!br.alive) continue;
        var cx = clamp(b.x, br.x, br.x + br.w);
        var cy = clamp(b.y, br.y, br.y + br.h);
        var dx = b.x - cx, dy = b.y - cy;
        if (dx * dx + dy * dy >= b.r * b.r) continue;
        var bcx = br.x + br.w / 2, bcy = br.y + br.h / 2;
        var ox = (br.w / 2 + b.r) - Math.abs(b.x - bcx);
        var oy = (br.h / 2 + b.r) - Math.abs(b.y - bcy);
        if (ox < oy) {
          b.vx *= -1;
          b.x += b.x < bcx ? -ox : ox;
        } else {
          b.vy *= -1;
          b.y += b.y < bcy ? -oy : oy;
        }
        damageBrick(br, 1, false);
        break;
      }
      if (G.state !== 'playing') break;
      if (b.y - b.r > f.y + f.h + 20) b.dead = true;
    }
    if (G.balls.some(function (ball) { return ball.dead; })) {
      G.balls = G.balls.filter(function (ball) { return !ball.dead; });
      if (G.balls.length === 0 && G.state === 'playing') loseLife();
    }
  }
  function updatePowerups(dt) {
    var f = G.field, p = G.paddle;
    for (var i = 0; i < G.powerups.length; i++) {
      var pu = G.powerups[i];
      pu.y += pu.vy * dt;
      pu.t += dt;
      if (pu.y - pu.r > f.y + f.h) { pu.dead = true; continue; }
      if (pu.y + pu.r >= p.y && pu.y - pu.r <= p.y + p.h &&
          pu.x + pu.r >= p.x && pu.x - pu.r <= p.x + p.w) {
        pu.dead = true;
        applyPowerup(pu);
      }
    }
    G.powerups = G.powerups.filter(function (pu) { return !pu.dead; });
  }
  function updateBullets(dt) {
    var p = G.paddle;
    if (G.buffs.laser > 0) {
      G.laserTimer -= dt;
      if (G.laserTimer <= 0) {
        G.laserTimer = 0.34;
        G.bullets.push({ x: p.x + 9, y: p.y - 1, vy: -920, dead: false });
        G.bullets.push({ x: p.x + p.w - 9, y: p.y - 1, vy: -920, dead: false });
        sfx('laser');
      }
    } else {
      G.laserTimer = 0;
    }
    for (var i = 0; i < G.bullets.length; i++) {
      var bu = G.bullets[i];
      bu.y += bu.vy * dt;
      if (bu.y < G.field.y - 20) { bu.dead = true; continue; }
      for (var j = 0; j < G.bricks.length; j++) {
        var br = G.bricks[j];
        if (!br.alive) continue;
        if (bu.x >= br.x && bu.x <= br.x + br.w && bu.y >= br.y && bu.y <= br.y + br.h) {
          bu.dead = true;
          damageBrick(br, 1, true);
          spawnSparks(bu.x, bu.y, '#ffd166', 5, 90);
          break;
        }
      }
    }
    G.bullets = G.bullets.filter(function (bu) { return !bu.dead; });
  }
  function updateBuffs(dt) {
    ['expand', 'slow', 'laser'].forEach(function (k) {
      if (G.buffs[k] > 0) {
        G.buffs[k] = Math.max(0, G.buffs[k] - dt);
      }
    });
  }
  /* ---------------- particles & text ---------------- */
  function brickColor(hp) {
    if (hp >= 3) return '#ffd166';
    if (hp === 2) return '#ff4fd8';
    return '#3ceaff';
  }
  function spawnSparks(x, y, color, n, power) {
    if (G.particles.length > 420) return;
    for (var i = 0; i < n; i++) {
      var a = rand(0, TAU);
      var s = rand(35, power);
      G.particles.push({
        x: x, y: y,
        vx: Math.cos(a) * s,
        vy: Math.sin(a) * s,
        g: 240,
        life: rand(0.22, 0.5),
        max: 0.5,
        size: rand(1.3, 2.6),
        color: color,
        spin: 0, angle: 0, square: false
      });
    }
  }
  function spawnBurst(x, y, color, n, power) {
    if (G.particles.length > 460) return;
    for (var i = 0; i < n; i++) {
      var a = rand(0, TAU);
      var s = rand(50, power);
      G.particles.push({
        x: x, y: y,
        vx: Math.cos(a) * s,
        vy: Math.sin(a) * s - 30,
        g: 420,
        life: rand(0.4, 0.9),
        max: 0.9,
        size: rand(1.8, 4.2),
        color: color,
        spin: rand(-7, 7),
        angle: rand(0, TAU),
        square: true
      });
    }
  }
  function addText(x, y, str, color, size) {
    if (G.texts.length > 26) G.texts.shift();
    G.texts.push({
      x: x, y: y, text: str, color: color || '#fff',
      size: size || 14, life: 0.95, max: 0.95
    });
  }
  function updateParticles(dt) {
    for (var i = G.particles.length - 1; i >= 0; i--) {
      var p = G.particles[i];
      p.life -= dt;
      if (p.life <= 0) { G.particles.splice(i, 1); continue; }
      p.x += p.vx * dt;
      p.y += p.vy * dt;
      p.vy += p.g * dt;
      p.vx *= Math.max(0, 1 - 1.4 * dt);
      p.angle += p.spin * dt;
    }
  }
  function updateTexts(dt) {
    for (var i = G.texts.length - 1; i >= 0; i--) {
      var t = G.texts[i];
      t.life -= dt;
      if (t.life <= 0) { G.texts.splice(i, 1); continue; }
      t.y -= 30 * dt;
    }
  }
  /* ---------------- update loop ---------------- */
  function update(dt) {
    G.time += dt;
    G.shake = Math.max(0, G.shake - (G.shake * 8 + 2) * dt);
    G.flash = Math.max(0, G.flash - dt * 2.1);
    updateParticles(dt);
    updateTexts(dt);
    if (G.banner) {
      G.banner.t += dt;
      if (G.banner.t > G.banner.dur + 0.45) G.banner = null;
    }
    if (G.state === 'menu') {
      if (Math.random() < dt * 5) {
        G.particles.push({
          x: rand(G.field.x, G.field.x + G.field.w),
          y: rand(G.field.y + G.field.h * 0.25, G.field.y + G.field.h),
          vx: rand(-9, 9), vy: rand(-26, -8), g: -3,
          life: rand(2.4, 4.5), max: 4.5, size: rand(1, 2.2),
          color: Math.random() < 0.5 ? '#3ceaff' : '#9b6bff',
          spin: 0, angle: 0, square: false
        });
      }
      return;
    }
    if (G.state === 'paused' || G.state === 'over') return;
    updatePaddle(dt);
    if (G.state === 'ready') {
      var b = G.balls[0];
      if (b) {
        b.x = G.paddle.x + G.paddle.w / 2;
        b.y = G.paddle.y - b.r - 3;
        b.trail.length = 0;
      }
      return;
    }
    if (G.state === 'clear') {
      G.clearTimer -= dt;
      if (G.clearTimer <= 0) {
        G.level++;
        buildStage();
      }
      return;
    }
    if (G.state !== 'playing') return;
    updateBuffs(dt);
    updatePowerups(dt);
    updateBullets(dt);
    if (G.comboTimer > 0) {
      G.comboTimer -= dt;
      if (G.comboTimer <= 0) { G.combo = 0; G.comboTimer = 0; }
    }
    G.balls.forEach(function (ball) {
      ball.trail.push({ x: ball.x, y: ball.y });
      if (ball.trail.length > 11) ball.trail.shift();
    });
    var steps = clamp(Math.ceil(dt / 0.007), 1, 8);
    for (var i = 0; i < steps; i++) {
      if (G.state !== 'playing') break;
      physics(dt / steps);
    }
  }
  /* ---------------- rendering ---------------- */
  function render() {
    var W = G.W, H = G.H;
    ctx.setTransform(G.dpr, 0, 0, G.dpr, 0, 0);
    ctx.clearRect(0, 0, W, H);
    if (G.bg) {
      ctx.drawImage(G.bg, 0, 0, W, H);
    } else {
      ctx.fillStyle = '#05030e';
      ctx.fillRect(0, 0, W, H);
    }
    drawStars();
    ctx.save();
    if (G.shake > 0.2) {
      ctx.translate(rand(-G.shake, G.shake) * 0.6, rand(-G.shake, G.shake) * 0.6);
    }
    drawField();
    drawBricks();
    drawPowerups();
    drawBullets();
    drawParticles();
    drawPaddle();
    drawBalls();
    ctx.restore();
    drawHudCanvas();
    drawBanner();
    drawReadyHint();
    if (G.flash > 0) {
      ctx.fillStyle = 'rgba(255,45,135,' + (G.flash * 0.2).toFixed(3) + ')';
      ctx.fillRect(0, 0, W, H);
    }
  }
  function drawStars() {
    ctx.save();
    for (var i = 0; i < G.stars.length; i++) {
      var s = G.stars[i];
      var a = 0.18 + 0.55 * (0.5 + 0.5 * Math.sin(G.time * s.speed + s.phase));
      ctx.fillStyle = s.warm
        ? 'rgba(255,214,170,' + a.toFixed(3) + ')'
        : 'rgba(180,235,255,' + a.toFixed(3) + ')';
      ctx.beginPath();
      ctx.arc(s.x, s.y, s.r, 0, TAU);
      ctx.fill();
    }
    ctx.restore();
  }
  function drawField() {
    var f = G.field;
    // side rails
    var sideGrad = ctx.createLinearGradient(0, f.y, 0, f.y + f.h);
    sideGrad.addColorStop(0, 'rgba(60,234,255,.32)');
    sideGrad.addColorStop(0.55, 'rgba(90,130,255,.10)');
    sideGrad.addColorStop(1, 'rgba(255,79,216,.22)');
    ctx.strokeStyle = sideGrad;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(f.x + 0.5, f.y);
    ctx.lineTo(f.x + 0.5, f.y + f.h);
    ctx.moveTo(f.x + f.w - 0.5, f.y);
    ctx.lineTo(f.x + f.w - 0.5, f.y + f.h);
    ctx.stroke();
    // top rail
    var topGrad = ctx.createLinearGradient(f.x, 0, f.x + f.w, 0);
    topGrad.addColorStop(0, 'rgba(60,234,255,0)');
    topGrad.addColorStop(0.12, 'rgba(60,234,255,.38)');
    topGrad.addColorStop(0.5, 'rgba(195,248,255,.8)');
    topGrad.addColorStop(0.88, 'rgba(255,79,216,.4)');
    topGrad.addColorStop(1, 'rgba(255,79,216,0)');
    ctx.strokeStyle = topGrad;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(f.x, f.y + 0.5);
    ctx.lineTo(f.x + f.w, f.y + 0.5);
    ctx.stroke();
    // corner brackets
    ctx.strokeStyle = 'rgba(120,240,255,.65)';
    ctx.lineWidth = 2;
    [[f.x, f.y, 1, 1], [f.x + f.w, f.y, -1, 1]].forEach(function (c) {
      ctx.beginPath();
      ctx.moveTo(c[0] + c[2] * 14, c[1]);
      ctx.lineTo(c[0], c[1]);
      ctx.lineTo(c[0], c[1] + c[3] * 14);
      ctx.stroke();
    });
    // danger zone
    var dg = ctx.createLinearGradient(0, f.y + f.h - 56, 0, f.y + f.h);
    dg.addColorStop(0, 'rgba(255,60,180,0)');
    dg.addColorStop(0.75, 'rgba(255,60,180,.05)');
    dg.addColorStop(1, 'rgba(255,60,180,.16)');
    ctx.fillStyle = dg;
    ctx.fillRect(f.x, f.y + f.h - 56, f.w, 56);
    var lowBall = G.balls.some(function (b) { return !b.attached && b.y > f.y + f.h * 0.78; });
    var pulse = 0.35 + 0.3 * Math.sin(G.time * (lowBall ? 10 : 2.4));
    ctx.strokeStyle = 'rgba(255,79,190,' + (lowBall ? (0.45 + pulse * 0.5) : 0.18).toFixed(3) + ')';
    ctx.lineWidth = lowBall ? 2 : 1;
    ctx.beginPath();
    ctx.moveTo(f.x, f.y + f.h - 0.5);
    ctx.lineTo(f.x + f.w, f.y + f.h - 0.5);
    ctx.stroke();
  }
  var BRICK_STYLE = {
    1: {
      top: 'rgba(130,250,255,.72)',
      mid: 'rgba(30,200,240,.42)',
      low: 'rgba(2,48,90,.84)',
      line: 'rgba(150,251,255,.98)',
      glow: 'rgba(60,234,255,.8)'
    },
    2: {
      top: 'rgba(255,165,246,.72)',
      mid: 'rgba(255,50,195,.42)',
      low: 'rgba(82,4,68,.86)',
      line: 'rgba(255,150,233,.98)',
      glow: 'rgba(255,63,201,.75)'
    },
    3: {
      top: 'rgba(255,238,172,.78)',
      mid: 'rgba(255,185,50,.44)',
      low: 'rgba(85,48,3,.86)',
      line: 'rgba(255,229,158,.98)',
      glow: 'rgba(255,197,71,.75)'
    }
  };
  function brickSprite(hp, maxHp, w, h) {
    var ww = Math.max(2, Math.round(w));
    var hh = Math.max(2, Math.round(h));
    var key = hp + '|' + maxHp + '|' + ww + '|' + hh;
    if (G.brickSprites.has(key)) return G.brickSprites.get(key);
    var c = document.createElement('canvas');
    c.width = Math.max(1, Math.ceil((ww + PAD * 2) * G.dpr));
    c.height = Math.max(1, Math.ceil((hh + PAD * 2) * G.dpr));
    var g = c.getContext('2d');
    g.setTransform(G.dpr, 0, 0, G.dpr, 0, 0);
    g.translate(PAD, PAD);
    var st = BRICK_STYLE[clamp(hp, 1, 3)];
    var rad = Math.min(6, hh * 0.3);
    var fill = g.createLinearGradient(0, 0, 0, hh);
    fill.addColorStop(0, st.top);
    fill.addColorStop(0.48, st.mid);
    fill.addColorStop(1, st.low);
    g.save();
    g.shadowColor = st.glow;
    g.shadowBlur = 17;
    rr(g, 0.5, 0.5, ww - 1, hh - 1, rad);
    g.fillStyle = fill;
    g.fill();
    g.restore();
    rr(g, 0.9, 0.9, ww - 1.8, hh - 1.8, rad);
    g.strokeStyle = st.line;
    g.lineWidth = 1.1;
    g.stroke();
    // glossy top edge
    var gloss = g.createLinearGradient(0, 1, 0, hh * 0.5);
    gloss.addColorStop(0, 'rgba(255,255,255,.55)');
    gloss.addColorStop(1, 'rgba(255,255,255,0)');
    g.fillStyle = gloss;
    rr(g, 3.5, 2, ww - 7, Math.max(2, hh * 0.34), 2);
    g.fill();
    // damage cracks
    if (hp < maxHp) {
      g.strokeStyle = 'rgba(4,6,16,.55)';
      g.lineWidth = 1;
      g.beginPath();
      var cx = ww * (0.3 + 0.18 * (maxHp - hp));
      g.moveTo(cx, 2);
      g.lineTo(cx - 3, hh * 0.42);
      g.lineTo(cx + 2, hh * 0.5);
      g.lineTo(cx - 2, hh - 2);
      if (hh > 14) {
        g.moveTo(cx + 2, hh * 0.5);
        g.lineTo(cx + 8, hh * 0.72);
      }
      g.stroke();
    }
    G.brickSprites.set(key, c);
    return c;
  }
  function drawBricks() {
    for (var i = 0; i < G.bricks.length; i++) {
      var b = G.bricks[i];
      if (!b.alive) continue;
      var sp = brickSprite(b.hp, b.maxHp, b.w, b.h);
      ctx.drawImage(sp, b.x - PAD, b.y - PAD, b.w + PAD * 2, b.h + PAD * 2);
      if (b.flash > 0) {
        ctx.globalAlpha = b.flash * 0.65;
        ctx.fillStyle = '#ffffff';
        rr(ctx, b.x + 1, b.y + 1, b.w - 2, b.h - 2, Math.min(5, b.h * 0.3));
        ctx.fill();
        ctx.globalAlpha = 1;
      }
      if (b.flash > 0) b.flash = Math.max(0, b.flash - 0.08);
    }
  }
  function drawPaddle() {
    var p = G.paddle;
    var r = p.h / 2;
    ctx.save();
    ctx.shadowColor = G.buffs.laser > 0 ? 'rgba(255,209,102,.85)' : 'rgba(60,234,255,.8)';
    ctx.shadowBlur = 18;
    var grd = ctx.createLinearGradient(0, p.y, 0, p.y + p.h);
    if (G.buffs.laser > 0) {
      grd.addColorStop(0, '#fff4cf');
      grd.addColorStop(0.45, '#ffd166');
      grd.addColorStop(1, '#ff8a3d');
    } else {
      grd.addColorStop(0, '#eafeff');
      grd.addColorStop(0.38, '#55eeff');
      grd.addColorStop(1, '#4f8bff');
    }
    rr(ctx, p.x, p.y, p.w, p.h, r);
    ctx.fillStyle = grd;
    ctx.fill();
    ctx.restore();
    ctx.save();
    rr(ctx, p.x + 2, p.y + 1.2, p.w - 4, Math.max(1.5, p.h * 0.28), 2);
    ctx.fillStyle = 'rgba(255,255,255,.6)';
    ctx.fill();
    ctx.restore();
    // center marker
    ctx.fillStyle = 'rgba(4,10,26,.55)';
    rr(ctx, p.x + p.w / 2 - 7, p.y + p.h * 0.36, 14, Math.max(2, p.h * 0.28), 2);
    ctx.fill();
    if (G.buffs.laser > 0) {
      ctx.save();
      ctx.fillStyle = '#ffe9ad';
      ctx.shadowColor = '#ffd166';
      ctx.shadowBlur = 10;
      [p.x + 7, p.x + p.w - 7].forEach(function (x) {
        ctx.beginPath();
        ctx.moveTo(x - 2.5, p.y);
        ctx.lineTo(x + 2.5, p.y);
        ctx.lineTo(x, p.y - 5);
        ctx.closePath();
        ctx.fill();
      });
      ctx.restore();
    }
  }
  function drawBalls() {
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (var i = 0; i < G.balls.length; i++) {
      var b = G.balls[i];
      for (var t = 0; t < b.trail.length; t++) {
        var q = b.trail[t];
        var a = (t / b.trail.length) * 0.17;
        ctx.fillStyle = 'rgba(80,235,255,' + a.toFixed(3) + ')';
        ctx.beginPath();
        ctx.arc(q.x, q.y, b.r * (0.35 + t / b.trail.length * 0.55), 0, TAU);
        ctx.fill();
      }
      var rg = ctx.createRadialGradient(b.x, b.y, 0, b.x, b.y, b.r * 2.1);
      rg.addColorStop(0, 'rgba(255,255,255,1)');
      rg.addColorStop(0.32, 'rgba(170,250,255,.95)');
      rg.addColorStop(0.68, 'rgba(60,220,255,.38)');
      rg.addColorStop(1, 'rgba(60,220,255,0)');
      ctx.fillStyle = rg;
      ctx.beginPath();
      ctx.arc(b.x, b.y, b.r * 2.1, 0, TAU);
      ctx.fill();
    }
    ctx.restore();
    ctx.save();
    for (var k = 0; k < G.balls.length; k++) {
      var ball = G.balls[k];
      ctx.shadowColor = 'rgba(90,240,255,.95)';
      ctx.shadowBlur = 16;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(ball.x, ball.y, ball.r, 0, TAU);
      ctx.fill();
    }
    ctx.restore();
  }
  function drawPowerups() {
    for (var i = 0; i < G.powerups.length; i++) {
      var pu = G.powerups[i];
      var meta = PU_META[pu.type];
      ctx.save();
      ctx.translate(pu.x, pu.y);
      ctx.rotate(Math.sin(pu.t * 3.2) * 0.08);
      ctx.shadowColor = meta.color;
      ctx.shadowBlur = 18;
      ctx.fillStyle = 'rgba(7,6,20,.92)';
      rr(ctx, -13, -13, 26, 26, 8);
      ctx.fill();
      ctx.strokeStyle = meta.color;
      ctx.lineWidth = 1.4;
      ctx.stroke();
      ctx.shadowBlur = 0;
      drawPUIcon(pu.type, meta.color);
      ctx.restore();
    }
  }
  function drawPUIcon(type, color) {
    ctx.save();
    ctx.strokeStyle = color;
    ctx.fillStyle = color;
    ctx.lineWidth = 1.8;
    ctx.lineCap = 'round';
    ctx.lineJoin = 'round';
    if (type === 'expand') {
      ctx.beginPath();
      ctx.moveTo(-6, 0); ctx.lineTo(6, 0);
      ctx.moveTo(-6, 0); ctx.lineTo(-3, -3);
      ctx.moveTo(-6, 0); ctx.lineTo(-3, 3);
      ctx.moveTo(6, 0); ctx.lineTo(3, -3);
      ctx.moveTo(6, 0); ctx.lineTo(3, 3);
      ctx.stroke();
    } else if (type === 'multi') {
      [[-5, 1], [0, -5], [5, 1]].forEach(function (c) {
        ctx.beginPath(); ctx.arc(c[0], c[1], 2.4, 0, TAU); ctx.fill();
      });
    } else if (type === 'slow') {
      ctx.beginPath();
      ctx.arc(0, 0, 6.5, 0, TAU);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(0, -3.6); ctx.lineTo(0, 0); ctx.lineTo(3.1, 1.6);
      ctx.stroke();
    } else if (type === 'laser') {
      ctx.beginPath();
      ctx.moveTo(-4, 6); ctx.lineTo(-4, -4);
      ctx.moveTo(4, 6); ctx.lineTo(4, -4);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(-4, -6); ctx.lineTo(-4, -4);
      ctx.moveTo(4, -6); ctx.lineTo(4, -4);
      ctx.stroke();
    } else if (type === 'life') {
      heartPath(ctx, 0, 0, 7);
      ctx.fill();
    }
    ctx.restore();
  }
  function heartPath(g, x, y, s) {
    g.beginPath();
    g.moveTo(x, y + s * 0.72);
    g.bezierCurveTo(x - s * 1.45, y - s * 0.25, x - s * 0.62, y - s * 1.05, x, y - s * 0.38);
    g.bezierCurveTo(x + s * 0.62, y - s * 1.05, x + s * 1.45, y - s * 0.25, x, y + s * 0.72);
    g.closePath();
  }
  function drawBullets() {
    if (!G.bullets.length) return;
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    ctx.strokeStyle = 'rgba(255,224,150,.95)';
    ctx.lineWidth = 2;
    ctx.shadowColor = '#ffd166';
    ctx.shadowBlur = 9;
    for (var i = 0; i < G.bullets.length; i++) {
      var b = G.bullets[i];
      ctx.beginPath();
      ctx.moveTo(b.x, b.y);
      ctx.lineTo(b.x, b.y + 15);
      ctx.stroke();
    }
    ctx.restore();
  }
  function drawParticles() {
    if (!G.particles.length) return;
    ctx.save();
    ctx.globalCompositeOperation = 'lighter';
    for (var i = 0; i < G.particles.length; i++) {
      var p = G.particles[i];
      var a = clamp(p.life / p.max, 0, 1);
      ctx.globalAlpha = a;
      ctx.fillStyle = p.color;
      if (p.square) {
        ctx.save();
        ctx.translate(p.x, p.y);
        ctx.rotate(p.angle);
        ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
        ctx.restore();
      } else {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size, 0, TAU);
        ctx.fill();
      }
    }
    ctx.restore();
    ctx.globalAlpha = 1;
  }
  function drawHudCanvas() {
    var f = G.field;
    if (G.combo >= 2 && (G.state === 'playing' || G.state === 'clear')) {
      var mult = comboMult();
      var x = f.x + 10, y = f.y + 9, w = 116, h = 24;
      ctx.save();
      rr(ctx, x, y, w, h, 8);
      ctx.fillStyle = 'rgba(12,10,28,.78)';
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,209,102,.42)';
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.font = '800 11px ' + FONT;
      ctx.textAlign = 'left';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = '#ffd166';
      ctx.shadowColor = 'rgba(255,209,102,.6)';
      ctx.shadowBlur = 8;
      ctx.fillText('COMBO ×' + mult, x + 10, y + 10);
      ctx.shadowBlur = 0;
      var barW = w - 20;
      ctx.fillStyle = 'rgba(255,255,255,.1)';
      rr(ctx, x + 10, y + 17, barW, 2.5, 1.2);
      ctx.fill();
      ctx.fillStyle = 'rgba(255,209,102,.85)';
      rr(ctx, x + 10, y + 17, barW * clamp(G.comboTimer / 3.4, 0, 1), 2.5, 1.2);
      ctx.fill();
      ctx.restore();
    }
    var active = [];
    ['expand', 'slow', 'laser'].forEach(function (k) {
      if (G.buffs[k] > 0) active.push(k);
    });
    if (!active.length) return;
    var bw = 66, bh = 23, gap = 6;
    var bx = f.x + f.w - 10;
    ctx.save();
    ctx.font = '700 10px ' + FONT;
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    for (var i = active.length - 1; i >= 0; i--) {
      var key = active[i];
      var meta = PU_META[key];
      var left = bx - bw;
      rr(ctx, left, f.y + 9, bw, bh, 8);
      ctx.fillStyle = 'rgba(12,10,28,.78)';
      ctx.fill();
      ctx.strokeStyle = meta.color + '66';
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.fillStyle = meta.color;
      ctx.fillText(meta.label + ' ' + Math.ceil(G.buffs[key]) + 's', left + bw / 2, f.y + 9 + bh / 2 - 2);
      var ratio = key === 'expand' ? G.buffs.expand / 10 : key === 'slow' ? G.buffs.slow / 7 : G.buffs.laser / 8;
      ctx.fillStyle = 'rgba(255,255,255,.1)';
      rr(ctx, left + 8, f.y + 28, bw - 16, 2, 1);
      ctx.fill();
      ctx.fillStyle = meta.color;
      rr(ctx, left + 8, f.y + 28, (bw - 16) * clamp(ratio, 0, 1), 2, 1);
      ctx.fill();
      bx = left - gap;
    }
    ctx.restore();
  }
  function drawTexts() {
    // fixed-position floating texts, drawn without shake
    for (var i = 0; i < G.texts.length; i++) {
      var t = G.texts[i];
      var a = clamp(t.life / t.max * 1.8, 0, 1);
      ctx.save();
      ctx.globalAlpha = a;
      ctx.font = '800 ' + t.size + 'px ' + FONT;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillStyle = t.color;
      ctx.shadowColor = t.color;
      ctx.shadowBlur = 10;
      ctx.fillText(t.text, t.x, t.y);
      ctx.restore();
    }
  }
  function drawBanner() {
    if (!G.banner) return;
    var b = G.banner;
    var t = b.t;
    var a = 1;
    if (t < 0.16) a = t / 0.16;
    else if (t > b.dur - 0.4) a = clamp((b.dur - t) / 0.4, 0, 1);
    if (a <= 0) return;
    var f = G.field;
    var gridBottom = G.gridTop + G.rows * (G.brickH + G.gap) - G.gap;
    var y = Math.max(gridBottom + 58, f.y + f.h * 0.34);
    y = Math.min(y, f.y + f.h - 128);
    var scale = 0.94 + easeOutCubic(clamp(t / 0.28, 0, 1)) * 0.06;
    ctx.save();
    ctx.globalAlpha = a;
    ctx.translate(f.x + f.w / 2, y);
    ctx.scale(scale, scale);
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    var titleSize = clamp(f.w * 0.048, 27, 46);
    var stripW = clamp(f.w - 16, 280, 640);
    var stripH = titleSize * 1.8;
    var stripGrad = ctx.createLinearGradient(-stripW / 2, 0, stripW / 2, 0);
    stripGrad.addColorStop(0, 'rgba(5,4,16,0)');
    stripGrad.addColorStop(0.2, 'rgba(5,4,16,.76)');
    stripGrad.addColorStop(0.8, 'rgba(5,4,16,.76)');
    stripGrad.addColorStop(1, 'rgba(5,4,16,0)');
    rr(ctx, -stripW / 2, -titleSize * 0.82, stripW, stripH, 16);
    ctx.fillStyle = stripGrad;
    ctx.fill();
    ctx.font = '900 ' + titleSize + 'px ' + FONT;
    ctx.fillStyle = '#ffffff';
    ctx.shadowColor = 'rgba(60,234,255,.75)';
    ctx.shadowBlur = 26;
    ctx.fillText(b.title, 0, 0);
    ctx.shadowBlur = 10;
    ctx.font = '700 11px ' + FONT;
    ctx.fillStyle = 'rgba(190,240,255,.78)';
    ctx.fillText(b.sub, 0, titleSize * 0.72);
    var lineW = clamp(f.w * 0.22, 70, 150);
    var lg = ctx.createLinearGradient(-lineW, 0, lineW, 0);
    lg.addColorStop(0, 'rgba(60,234,255,0)');
    lg.addColorStop(0.5, 'rgba(60,234,255,.55)');
    lg.addColorStop(1, 'rgba(60,234,255,0)');
    ctx.strokeStyle = lg;
    ctx.lineWidth = 1;
    ctx.shadowBlur = 0;
    ctx.beginPath();
    ctx.moveTo(-lineW, -titleSize * 0.72);
    ctx.lineTo(lineW, -titleSize * 0.72);
    ctx.stroke();
    ctx.restore();
  }
  function drawReadyHint() {
    if (G.state !== 'ready') return;
    var f = G.field, p = G.paddle;
    var pulse = 0.55 + 0.45 * Math.sin(G.time * 3.2);
    var y = p.y - 58;
    ctx.save();
    ctx.textAlign = 'center';
    ctx.textBaseline = 'middle';
    ctx.font = '800 13px ' + FONT;
    ctx.fillStyle = 'rgba(225,250,255,' + (0.55 + pulse * 0.4).toFixed(3) + ')';
    ctx.shadowColor = 'rgba(60,234,255,.6)';
    ctx.shadowBlur = 10;
    ctx.fillText(G.coarse ? '轻触画面发球' : '点击画面 / 空格发球', f.x + f.w / 2, y);
    var second = G.coarse ? '手指左右拖动控制挡板' : '移动鼠标或 ← → 控制挡板';
    ctx.font = '500 11px ' + FONT;
    ctx.fillStyle = 'rgba(130,160,190,.75)';
    ctx.shadowBlur = 0;
    ctx.fillText(second, f.x + f.w / 2, y + 18);
    ctx.restore();
  }
  /* ---------------- loop ---------------- */
  function loop(now) {
    if (!G.last) G.last = now;
    var dt = (now - G.last) / 1000;
    G.last = now;
    if (!isFinite(dt) || dt < 0) dt = 0;
    dt = Math.min(dt, 0.05);
    update(dt);
    render();
    drawTexts();
    requestAnimationFrame(loop);
  }
  /* ---------------- input ---------------- */
  function onPointerMove(e) {
    if (G.state === 'playing' || G.state === 'ready') {
      G.paddle.targetX = e.clientX;
    }
  }
  function onPointerDown(e) {
    initAudio();
    if (G.state === 'ready') {
      G.paddle.targetX = e.clientX;
      updatePaddle(0.016);
      launch();
    }
  }
  canvas.addEventListener('pointermove', onPointerMove, { passive: true });
  canvas.addEventListener('pointerdown', onPointerDown, { passive: true });
  window.addEventListener('keydown', function (e) {
    var k = e.key;
    var inButton = e.target && e.target.closest && e.target.closest('button');
    if (k === 'ArrowLeft' || k === 'a' || k === 'A') {
      e.preventDefault();
      if (!G.keys.left && !G.keys.right) G.paddle.targetX = G.paddle.x + G.paddle.w / 2;
      G.keys.left = true;
    } else if (k === 'ArrowRight' || k === 'd' || k === 'D') {
      e.preventDefault();
      if (!G.keys.left && !G.keys.right) G.paddle.targetX = G.paddle.x + G.paddle.w / 2;
      G.keys.right = true;
    } else if (k === ' ' || k === 'Spacebar') {
      if (inButton) return;
      e.preventDefault();
      initAudio();
      if (G.state === 'ready') launch();
      else if (G.state === 'menu') startGame();
      else if (G.state === 'over') startGame();
    } else if (k === 'Enter') {
      if (inButton) return;
      if (G.state === 'menu' || G.state === 'over') { e.preventDefault(); startGame(); }
      else if (G.state === 'paused') { e.preventDefault(); resumeGame(); }
    } else if (k === 'p' || k === 'P' || k === 'Escape') {
      if (G.state === 'paused') resumeGame();
      else pauseGame();
    } else if (k === 'm' || k === 'M') {
      toggleMute();
    }
  });
  window.addEventListener('keyup', function (e) {
    var k = e.key;
    if (k === 'ArrowLeft' || k === 'a' || k === 'A') G.keys.left = false;
    if (k === 'ArrowRight' || k === 'd' || k === 'D') G.keys.right = false;
  });
  window.addEventListener('blur', function () {
    G.keys.left = false;
    G.keys.right = false;
    pauseGame();
  });
  window.addEventListener('pagehide', saveBest);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) pauseGame();
  });
  overlay.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-action]');
    if (!btn) return;
    initAudio();
    var action = btn.getAttribute('data-action');
    if (action === 'start' || action === 'restart') {
      startGame();
    } else if (action === 'resume') {
      resumeGame();
    } else if (action === 'menu') {
      showMenu();
    }
  });
  pauseBtn.addEventListener('click', function () {
    initAudio();
    if (G.state === 'paused') resumeGame();
    else pauseGame();
  });
  soundBtn.addEventListener('click', function () {
    initAudio();
    toggleMute();
  });
  var resizeRaf = 0;
  window.addEventListener('resize', function () {
    if (resizeRaf) return;
    resizeRaf = requestAnimationFrame(function () {
      resizeRaf = 0;
      resize();
      if (G.state === 'ready') {
        G.balls = [makeAttachedBall()];
      }
    });
  });
  /* ---------------- boot ---------------- */
  loadStore();
  G.coarse = !!(window.matchMedia && window.matchMedia('(pointer: coarse)').matches);
  renderSoundBtn();
  resize();
  showMenu();
  G.last = performance.now();
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
